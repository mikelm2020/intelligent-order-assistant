APP_NAME=Intelligent Order Assistant
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/intelligent_orders

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
RAG_MAX_DISTANCE=0.4


# Use distinct randomly generated keys of at least 32 characters.
OPERATOR_API_KEY=
REVIEWER_API_KEY=
APPROVAL_TTL_SECONDS=900

# demo is offline and illustrative; openai uses real model requests.
AI_PROVIDER=demo
# Deployment only: use a random hex password (safe in the connection URL).
DB_PASSWORD=
